name: "x-alp:ip:power_manager"
description: "X-ALP power manager (power and clock gating)"

filesets:
  files_rtl:
    depend:
      - pulp-platform.org::common_cells
      - pulp-platform.org::register_interface
    files:
      - rtl/power_manager_pkg.sv
      - rtl/power_manager_reg_pkg.sv
      - rtl/power_manager_reg_top.sv
      - rtl/power_manager_domain.sv
      - rtl/axi_idle_monitor.sv
      - rtl/power_manager.sv
    file_type: systemVerilogSource

  verilator_waiver:
    files:
      - power_manager.vlt
    file_type: vlt

targets:
  default:
    filesets:
      - files_rtl
      - tool_verilator ? (verilator_waiver)
